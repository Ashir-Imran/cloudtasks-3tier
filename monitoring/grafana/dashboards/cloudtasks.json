{
  "title": "CloudTasks - Application",
  "uid": "cloudtasks",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Requests per second (by endpoint)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_requests_total[1m])) by (endpoint)", "legendFormat": "{{endpoint}}" } ] },
    { "id": 2, "type": "timeseries", "title": "p95 latency (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95" } ] },
    { "id": 3, "type": "timeseries", "title": "Responses by status code",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_requests_total[1m])) by (status)", "legendFormat": "{{status}}" } ] },
    { "id": 4, "type": "stat", "title": "5xx errors (last 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [ { "refId": "A", "expr": "sum(increase(http_requests_total{status=~\"5..\"}[5m])) or vector(0)" } ] }
  ]
}
